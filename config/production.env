DATABASE_ECHO=false

# 🌐 Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=false
ENVIRONMENT=production

# 🔒 Security Configuration
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000", "https://daena.ai"]
API_KEY_HEADER=X-API-Key
RATE_LIMIT_PER_MINUTE=100

# 📊 Monitoring & Logging
LOG_LEVEL=INFO
ENABLE_METRICS=true
ENABLE_HEALTH_CHECKS=true

# 🤖 AI Configuration
DEFAULT_LLM_PROVIDER=openai
FALLBACK_LLM_PROVIDERS=gemini,anthropic,deepseek
MAX_TOKENS=4000
TEMPERATURE=0.7

# 🎯 CMP Configuration
CMP_ENABLED=true
CMP_VOTING_THRESHOLD=0.7
CMP_CONSENSUS_REQUIRED=true

# 📱 Frontend Configuration
FRONTEND_URL=http://localhost:8000
WEBSOCKET_URL=ws://localhost:8000/ws
ENABLE_REALTIME_UPDATES=true

# 🔄 Auto-refresh Configuration
DASHBOARD_REFRESH_INTERVAL=30
AGENT_STATUS_REFRESH_INTERVAL=15
PROJECT_UPDATE_INTERVAL=60 